{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arra-memory-lab-onclick",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arra-memory-lab-oneclick",
      "database_id": "bbaf02d8-7cb4-4f46-80d9-5b6f3b9b2f9d",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "81dab83eba964ff68516aa61754868fe"
    }
  ],
  "vars": {
    "SEMANTIC_MAX_DISTANCE": "0.7"
  }
}
